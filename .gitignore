.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Raw and intermediate research data are kept locally, not in Git.
data/raw/**
data/intermediate/**
data/legacy/**

# Generated article outputs are reproducible and documented separately.
results/**
